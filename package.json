{
  "name": "your-next-webapp",
  "version": "0.1.0",
  "description": "Modern full-stack Next.js web application template featuring next-intl i18n, Firebase Auth, responsive dashboards, and interactive workflow canvas.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/exxaio/your-next-webapp.git"
  },
  "bugs": {
    "url": "https://github.com/exxaio/your-next-webapp/issues"
  },
  "homepage": "https://github.com/exxaio/your-next-webapp#readme",
  "keywords": [
    "nextjs",
    "react19",
    "tailwind",
    "shadcn-ui",
    "firebase-auth",
    "next-intl",
    "workflow-builder",
    "dashboard",
    "starter-kit"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx}\"",
    "check": "pnpm format:check && pnpm lint",
    "typecheck": "tsc --noEmit",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "firebase": "^13.1.0",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.3",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3"
  }
}
