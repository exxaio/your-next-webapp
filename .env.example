# =============================================================================
# REQUIRED / MANDATORY — app will not start/function without these
# =============================================================================

# --- Firebase Authentication & App Configuration ---
# Obtain these credentials from: Firebase Console > Settings > General > Your apps
# Setup guide available at: docs/FIREBASE_SETUP.md
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id


# =============================================================================
# OPTIONAL — defaults shown or omit to use built-in defaults
# =============================================================================

# --- Firebase Analytics ---
# Measurement ID for Google Analytics via Firebase (starts with G-)
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
